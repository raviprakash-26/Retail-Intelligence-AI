# Deterministic configuration for the automated test suite.
# Contains no real secrets and is safe to commit.
NODE_ENV=test
APP_URL=http://localhost:3000
DATABASE_URL="postgresql://riai:riai@localhost:5432/riai_test?schema=public"
DIRECT_DATABASE_URL="postgresql://riai:riai@localhost:5432/riai_test?schema=public"
AUTH_SECRET="test-only-secret-value-not-used-in-any-real-environment"
PASSWORD_HASH_ROUNDS=4
STORAGE_DRIVER=local
AI_DRIVER=disabled
PAYMENTS_DRIVER=disabled
EMAIL_DRIVER=console
RATE_LIMIT_DRIVER=memory
LOG_LEVEL=error
