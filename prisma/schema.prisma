model Sale {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @db.Uuid
  branchId       String?        @db.Uuid
  customerId     String?        @db.Uuid

  invoiceNumber  String
  invoiceDate    DateTime       @db.Date
  dueDate        DateTime?      @db.Date
  status         DocumentStatus @default(DRAFT)
  paymentMode    PaymentMode    @default(CASH)
  supplyType     TaxSupplyType  @default(INTRA_STATE)
  placeOfSupply  String?

  subTotal       Decimal        @default(0) @db.Decimal(18, 4)
  discountAmount Decimal        @default(0) @db.Decimal(18, 4)
  taxableAmount  Decimal        @default(0) @db.Decimal(18, 4)
  cgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  sgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  igstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  cessAmount     Decimal        @default(0) @db.Decimal(18, 4)
  roundOff       Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal        @default(0) @db.Decimal(18, 4)
  /// Amount settled at the time of invoicing (cash/UPI/card portion).
  paidAmount     Decimal        @default(0) @db.Decimal(18, 4)
  /// Cost of goods sold captured at posting time from the valuation engine.
  costOfGoodsSold Decimal       @default(0) @db.Decimal(18, 4)

  notes          String?
  journalEntryId String?        @db.Uuid
  postedAt       DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?        @db.Uuid
