  branch  Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items   SaleItem[]
  returns SalesReturn[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, invoiceDate])
  @@index([companyId, status, invoiceDate])
  @@index([companyId, customerId, invoiceDate])
  @@map("sales")
}

model SaleItem {
  id             String  @id @default(uuid(7)) @db.Uuid
  companyId      String  @db.Uuid
  saleId         String  @db.Uuid
  productId      String  @db.Uuid
  taxRateId      String? @db.Uuid
  lineNumber     Int

  description    String?
  hsnCode        String?
  quantity       Decimal @db.Decimal(18, 3)
  rate           Decimal @db.Decimal(18, 4)
  discountPercent Decimal @default(0) @db.Decimal(9, 4)
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  taxableAmount  Decimal @default(0) @db.Decimal(18, 4)
  taxPercent     Decimal @default(0) @db.Decimal(9, 4)
  cgstAmount     Decimal @default(0) @db.Decimal(18, 4)
  sgstAmount     Decimal @default(0) @db.Decimal(18, 4)
  igstAmount     Decimal @default(0) @db.Decimal(18, 4)
  cessAmount     Decimal @default(0) @db.Decimal(18, 4)
  lineTotal      Decimal @default(0) @db.Decimal(18, 4)
  /// Unit cost consumed from inventory, per the company's valuation method.
  unitCost       Decimal @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@unique([saleId, lineNumber])
  @@index([companyId, productId])
  @@map("sale_items")
}

model SalesReturn {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @db.Uuid
  saleId         String?        @db.Uuid
  customerId     String?        @db.Uuid
  returnNumber   String
  returnDate     DateTime       @db.Date
  status         DocumentStatus @default(DRAFT)
  reason         String?

  subTotal       Decimal        @default(0) @db.Decimal(18, 4)
  taxableAmount  Decimal        @default(0) @db.Decimal(18, 4)
  cgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  sgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  igstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  cessAmount     Decimal        @default(0) @db.Decimal(18, 4)
  /// Difference between the exact value returned and the rupee it is
  /// credited at, posted to Round Off exactly as an invoice's is.
  roundOff       Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal        @default(0) @db.Decimal(18, 4)
  costOfGoodsReturned Decimal   @default(0) @db.Decimal(18, 4)

  journalEntryId String?        @db.Uuid
  postedAt       DateTime?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale     Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    SalesReturnItem[]

  @@unique([companyId, returnNumber])
  @@index([companyId, returnDate])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String  @id @default(uuid(7)) @db.Uuid
  companyId     String  @db.Uuid
  salesReturnId String  @db.Uuid
  productId     String  @db.Uuid
  lineNumber    Int
  quantity      Decimal @db.Decimal(18, 3)
  rate          Decimal @db.Decimal(18, 4)
  taxableAmount Decimal @default(0) @db.Decimal(18, 4)
  taxPercent    Decimal @default(0) @db.Decimal(9, 4)
  cgstAmount    Decimal @default(0) @db.Decimal(18, 4)
  sgstAmount    Decimal @default(0) @db.Decimal(18, 4)
  igstAmount    Decimal @default(0) @db.Decimal(18, 4)
  cessAmount    Decimal @default(0) @db.Decimal(18, 4)
  lineTotal     Decimal @default(0) @db.Decimal(18, 4)
  unitCost      Decimal @default(0) @db.Decimal(18, 4)
  createdAt     DateTime @default(now())

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@unique([salesReturnId, lineNumber])
  @@index([companyId, productId])
  @@map("sales_return_items")
}

