  branchId       String?        @db.Uuid
  categoryId     String         @db.Uuid

  voucherNumber  String
  expenseDate    DateTime       @db.Date
  status         DocumentStatus @default(DRAFT)
  paymentMode    PaymentMode    @default(CASH)

  /// Whom the expense was paid to; free text when not a registered supplier.
  payeeName      String?
  partyType      PartyType?
  partyId        String?        @db.Uuid

  amount         Decimal        @db.Decimal(18, 4)
  taxableAmount  Decimal        @default(0) @db.Decimal(18, 4)
  cgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  sgstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  igstAmount     Decimal        @default(0) @db.Decimal(18, 4)
  totalAmount    Decimal        @db.Decimal(18, 4)
  itcEligible    Boolean        @default(false)

  /// Capital expenditure is routed to a fixed asset, not to the P&L.
  isCapitalExpenditure Boolean  @default(false)
  referenceNo    String?
  attachmentUrl  String?
  notes          String?

  journalEntryId String?        @db.Uuid
  postedAt       DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch   Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([companyId, voucherNumber])
  @@index([companyId, expenseDate])
  @@index([companyId, categoryId, expenseDate])
  @@map("expenses")
}

// =============================================================================
// RECEIPTS & PAYMENTS
// =============================================================================

/// Money coming in: customer collections, other income, loans, capital.
model Receipt {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @db.Uuid
  customerId     String?        @db.Uuid
  voucherNumber  String
  receiptDate    DateTime       @db.Date
  status         DocumentStatus @default(DRAFT)
  paymentMode    PaymentMode    @default(CASH)
  /// Which system account the money landed in (CASH / a bank ledger).
  depositAccountId String?      @db.Uuid
  /// Nature of the receipt, e.g. "CUSTOMER", "CAPITAL", "LOAN", "OTHER_INCOME".
  source         String         @default("CUSTOMER")
  /// Credit side when the receipt is not a customer collection.
  counterAccountId String?      @db.Uuid
  amount         Decimal        @db.Decimal(18, 4)
  referenceNo    String?
  notes          String?
  journalEntryId String?        @db.Uuid
  postedAt       DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  allocations ReceiptAllocation[]

  @@unique([companyId, voucherNumber])
  @@index([companyId, receiptDate])
  @@index([companyId, customerId])
  @@map("receipts")
}

/// Settles a receipt against specific sales invoices so ageing stays accurate.
model ReceiptAllocation {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String  @db.Uuid
  receiptId String  @db.Uuid
  saleId    String  @db.Uuid
  amount    Decimal @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, saleId])
  @@index([companyId, saleId])
  @@map("receipt_allocations")
}

/// Money going out: supplier settlements, salaries, loans, other payouts.
model Payment {
  id             String         @id @default(uuid(7)) @db.Uuid
  companyId      String         @db.Uuid
  supplierId     String?        @db.Uuid
  voucherNumber  String
  paymentDate    DateTime       @db.Date
  status         DocumentStatus @default(DRAFT)
  paymentMode    PaymentMode    @default(CASH)
  /// Which system account the money left from (CASH / a bank ledger).
  sourceAccountId String?       @db.Uuid
  /// Nature of the payment, e.g. "SUPPLIER", "SALARY", "LOAN", "DRAWINGS".
  purpose        String         @default("SUPPLIER")
  counterAccountId String?      @db.Uuid
  amount         Decimal        @db.Decimal(18, 4)
  referenceNo    String?
  notes          String?
  journalEntryId String?        @db.Uuid
  postedAt       DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([companyId, voucherNumber])
  @@index([companyId, paymentDate])
  @@index([companyId, supplierId])
  @@map("payments")
}

model PaymentAllocation {
  id         String  @id @default(uuid(7)) @db.Uuid
  companyId  String  @db.Uuid
  paymentId  String  @db.Uuid
  purchaseId String  @db.Uuid
  amount     Decimal @db.Decimal(18, 4)
  createdAt  DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, purchaseId])
  @@index([companyId, purchaseId])
  @@map("payment_allocations")
}

// =============================================================================
// INVENTORY
// =============================================================================

/// Current on-hand position per product per branch. Maintained transactionally
/// alongside every stock movement; never recomputed lazily from documents.
model InventoryBalance {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @db.Uuid
  productId     String   @db.Uuid
  branchId      String?  @db.Uuid
  quantity      Decimal  @default(0) @db.Decimal(18, 3)
  /// Weighted-average unit cost, or the FIFO-layer-derived value.
  averageCost   Decimal  @default(0) @db.Decimal(18, 4)
  stockValue    Decimal  @default(0) @db.Decimal(18, 4)
  lastMovementAt DateTime?
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([companyId, productId, branchId])
  @@index([companyId, quantity])
  @@map("inventory_balances")
}

/// Append-only stock ledger. Every quantity change in the system produces one
/// row here, which is what makes stock reconstructable and auditable.
model InventoryMovement {
  id           String            @id @default(uuid(7)) @db.Uuid
  companyId    String            @db.Uuid
  productId    String            @db.Uuid
  branchId     String?           @db.Uuid
  movementType StockMovementType
  movementDate DateTime          @db.Date

  /// Signed: positive for inward, negative for outward.
  quantity     Decimal           @db.Decimal(18, 3)
  unitCost     Decimal           @default(0) @db.Decimal(18, 4)
  value        Decimal           @default(0) @db.Decimal(18, 4)

  /// Running position captured at write time for point-in-time reporting.
  balanceQuantity Decimal        @default(0) @db.Decimal(18, 3)
  balanceValue    Decimal        @default(0) @db.Decimal(18, 4)

  sourceType   String?
  sourceId     String?           @db.Uuid
  referenceNo  String?
  notes        String?
  createdById  String?           @db.Uuid
  createdAt    DateTime          @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId, movementDate])
  @@index([companyId, movementDate])
  @@index([sourceType, sourceId])
  @@map("inventory_movements")
}

// =============================================================================
// FIXED ASSETS
// =============================================================================

model FixedAsset {
  id                 String             @id @default(uuid(7)) @db.Uuid
  companyId          String             @db.Uuid
  accountId          String?            @db.Uuid
  code               String
  name               String
  category           String?
  purchaseDate       DateTime           @db.Date
  purchaseCost       Decimal            @db.Decimal(18, 4)
  salvageValue       Decimal            @default(0) @db.Decimal(18, 4)
  usefulLifeMonths   Int                @default(60)
  method             DepreciationMethod @default(WRITTEN_DOWN_VALUE)
  ratePercent        Decimal            @default(0) @db.Decimal(9, 4)
  accumulatedDepreciation Decimal       @default(0) @db.Decimal(18, 4)
  bookValue          Decimal            @db.Decimal(18, 4)
  disposedAt         DateTime?
  disposalValue      Decimal?           @db.Decimal(18, 4)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  depreciationEntries DepreciationEntry[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @db.Uuid
  fixedAssetId   String   @db.Uuid
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date
  openingValue   Decimal  @db.Decimal(18, 4)
  depreciation   Decimal  @db.Decimal(18, 4)
  closingValue   Decimal  @db.Decimal(18, 4)
  journalEntryId String?  @db.Uuid
  postedAt       DateTime?
  createdAt      DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fixedAsset FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  @@unique([fixedAssetId, periodStart, periodEnd])
  @@index([companyId, periodEnd])
  @@map("depreciation_entries")
}

// =============================================================================
// PAYROLL
// =============================================================================

model Employee {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @db.Uuid
  accountId    String?        @db.Uuid
  employeeCode String
  name         String
  email        String?
  phone        String?
  department   String?
  designation  String?
  joiningDate  DateTime       @db.Date
  exitDate     DateTime?      @db.Date
  status       EmployeeStatus @default(ACTIVE)
  basicSalary  Decimal        @default(0) @db.Decimal(18, 4)
  allowances   Decimal        @default(0) @db.Decimal(18, 4)
  panNumber    String?
  bankAccountNo String?
  ifsc         String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payrollItems PayrollItem[]

  @@unique([companyId, employeeCode])
  @@index([companyId, status])
  @@map("employees")
}

/// A payroll run for one period; individual employee amounts live in items.
model Payroll {
  id             String        @id @default(uuid(7)) @db.Uuid
  companyId      String        @db.Uuid
  reference      String
  periodMonth    Int
  periodYear     Int
  payDate        DateTime      @db.Date
  status         PayrollStatus @default(DRAFT)
  grossAmount    Decimal       @default(0) @db.Decimal(18, 4)
  deductionAmount Decimal      @default(0) @db.Decimal(18, 4)
  /// Employer PF and ESI: on top of gross, not withheld from it.
  employerContributions Decimal @default(0) @db.Decimal(18, 4)
  netAmount      Decimal       @default(0) @db.Decimal(18, 4)
  journalEntryId String?       @db.Uuid
  postedAt       DateTime?
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PayrollItem[]

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, status])
  @@map("payroll")
}

model PayrollItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @db.Uuid
  payrollId   String   @db.Uuid
  employeeId  String   @db.Uuid
  basicSalary Decimal  @default(0) @db.Decimal(18, 4)
  allowances  Decimal  @default(0) @db.Decimal(18, 4)
  /// Total withheld. The components below add up to it; both are stored so a
  /// payslip and a remittance can be answered from the same row.
  deductions  Decimal  @default(0) @db.Decimal(18, 4)
  employeeProvidentFund  Decimal @default(0) @db.Decimal(18, 4)
  employeeStateInsurance Decimal @default(0) @db.Decimal(18, 4)
  professionalTax        Decimal @default(0) @db.Decimal(18, 4)
  /// Entered by whoever runs the payroll. This platform does not compute TDS.
  taxDeductedAtSource    Decimal @default(0) @db.Decimal(18, 4)
  /// The employer's own contributions: a cost, not a deduction.
  employerProvidentFund  Decimal @default(0) @db.Decimal(18, 4)
  employerStateInsurance Decimal @default(0) @db.Decimal(18, 4)
  netSalary   Decimal  @default(0) @db.Decimal(18, 4)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollId, employeeId])
  @@index([companyId, employeeId])
  @@map("payroll_items")
}

// =============================================================================
// GST
// =============================================================================

/// Flattened GST register row. One per taxable document line group, written at
/// posting time so returns are prepared from immutable facts rather than by
/// re-deriving tax from live documents that may since have changed.
model GstTransaction {
  id            String       @id @default(uuid(7)) @db.Uuid
  companyId     String       @db.Uuid
  taxRateId     String?      @db.Uuid
  direction     GstDirection
  documentType  String
  documentId    String       @db.Uuid
  documentNumber String
  documentDate  DateTime     @db.Date
  periodYear    Int
  periodMonth   Int

  partyName     String?
  partyGstin    String?
  placeOfSupply String?
  supplyType    TaxSupplyType @default(INTRA_STATE)
  hsnCode       String?

  taxableValue  Decimal      @default(0) @db.Decimal(18, 4)
  ratePercent   Decimal      @default(0) @db.Decimal(9, 4)
  cgstAmount    Decimal      @default(0) @db.Decimal(18, 4)
  sgstAmount    Decimal      @default(0) @db.Decimal(18, 4)
  igstAmount    Decimal      @default(0) @db.Decimal(18, 4)
  cessAmount    Decimal      @default(0) @db.Decimal(18, 4)
  totalTax      Decimal      @default(0) @db.Decimal(18, 4)

  itcEligible   Boolean      @default(false)
  reverseCharge Boolean      @default(false)
  isAmendment   Boolean      @default(false)
  createdAt     DateTime     @default(now())

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([companyId, periodYear, periodMonth, direction])
  @@index([companyId, documentDate])
  @@index([documentType, documentId])
  @@map("gst_transactions")
}

/// A GST return period. Status never claims a return was filed with the
/// authority — the platform prepares and validates; filing happens elsewhere.
model GstPeriod {
  id             String          @id @default(uuid(7)) @db.Uuid
  companyId      String          @db.Uuid
  periodYear     Int
  periodMonth    Int
  status         GstPeriodStatus @default(OPEN)
  outputTax      Decimal         @default(0) @db.Decimal(18, 4)
  inputTax       Decimal         @default(0) @db.Decimal(18, 4)
  reverseChargeTax Decimal       @default(0) @db.Decimal(18, 4)
  netPayable     Decimal         @default(0) @db.Decimal(18, 4)
  /// Snapshot of the prepared GSTR-1 / GSTR-3B working, kept for audit.
  preparedSummary Json?
  preparedAt     DateTime?
  preparedById   String?         @db.Uuid
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodYear, periodMonth])
  @@index([companyId, status])
  @@map("gst_periods")
}

// =============================================================================
// AUDIT
// =============================================================================

/// Append-only activity log. Rows are never updated or deleted; the migration
/// revokes UPDATE/DELETE at the database level for the application role.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String?  @db.Uuid
  userId     String?  @db.Uuid
  actorEmail String?
  action     String
  module     String
  entityType String?
  entityId   String?
  /// Structured before/after payload with sensitive fields already redacted.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([companyId, module, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One execution of the automated audit rule set.
model AuditRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @db.Uuid
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  /// 0-100. Deterministic, computed from finding severities — not AI-generated.
  score         Int       @default(0)
  riskLevel     AuditSeverity @default(LOW)
  findingsCount Int       @default(0)
  rulesVersion  String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggeredById String?   @db.Uuid

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  findings AuditFinding[]

  @@index([companyId, startedAt])
  @@map("audit_runs")
}

model AuditFinding {
  id             String             @id @default(uuid(7)) @db.Uuid
  companyId      String             @db.Uuid
  auditRunId     String?            @db.Uuid
  /// Stable rule identifier, e.g. "DUPLICATE_INVOICE_NUMBER".
  ruleKey        String
  severity       AuditSeverity
  status         AuditFindingStatus @default(OPEN)
  title          String
  description    String
  /// Why the rule fired, in plain language, with the data that triggered it.
  evidence       Json?
  recommendation String?
  entityType     String?
  entityId       String?            @db.Uuid
  detectedAt     DateTime           @default(now())
  resolvedAt     DateTime?
  resolvedById   String?            @db.Uuid
  resolutionNote String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditRun AuditRun? @relation(fields: [auditRunId], references: [id], onDelete: SetNull)

  @@index([companyId, status, severity])
  @@index([companyId, ruleKey])
  @@index([entityType, entityId])
  @@map("audit_findings")
}

// =============================================================================
// AI
// =============================================================================

model AiConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  agent     AiAgent  @default(ACCOUNTANT)
  title     String?
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([companyId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @db.Uuid
  conversationId String   @db.Uuid
  role           AiRole
  content        String
  /// Tool calls the model made and the data returned, so every figure quoted
  /// in an answer is traceable to a deterministic query.
  toolCalls      Json?
  /// Report/document references backing the answer.
  citations      Json?
  model          String?
  promptTokens   Int?
  outputTokens   Int?
  latencyMs      Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

model Forecast {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @db.Uuid
  metric       ForecastMetric
  /// Model identifier, e.g. "naive_seasonal_v1". Forecasts are produced by
  /// deterministic statistics; the LLM only narrates them.
  method       String
  generatedAt  DateTime       @default(now())
  horizonMonths Int           @default(3)
  /// Historical points the model consumed.
  historyFrom  DateTime       @db.Date
  historyTo    DateTime       @db.Date
  /// Array of {periodStart, point, lower, upper}.
  points       Json
  /// Reported so the UI can avoid presenting false precision.
  confidence   Decimal?       @db.Decimal(9, 4)
  limitations  String?
  createdById  String?        @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, metric, generatedAt])
  @@map("forecasts")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  companyId String               @db.Uuid
  /// NULL broadcasts to every member of the company.
  userId    String?              @db.Uuid
  type      String
  severity  NotificationSeverity @default(INFO)
  title     String
  body      String
  actionUrl String?
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, readAt])
  @@index([companyId, createdAt])
  @@map("notifications")
}
