# =============================================================================
# Retail Intelligence AI — environment configuration
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every variable here is validated at boot by `src/lib/env.ts`; the app refuses
# to start with an invalid configuration rather than failing at runtime.
#
# Variables NOT prefixed with NEXT_PUBLIC_ are server-only and are never
# bundled into client JavaScript.
# =============================================================================

# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Canonical, publicly reachable origin. Used for cookies, emails and callbacks.
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Pooled connection used by the application at runtime.
DATABASE_URL="postgresql://riai:riai@localhost:5432/riai_dev?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Required when the
# runtime URL points at a connection pooler such as PgBouncer.
DIRECT_DATABASE_URL="postgresql://riai:riai@localhost:5432/riai_dev?schema=public"

# --- Authentication & sessions -----------------------------------------
# 32+ byte random secret. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-value-at-least-32-chars"
# Idle session lifetime in seconds (default 12h).
SESSION_MAX_AGE_SECONDS=43200
# Bcrypt work factor. 12 is the production floor; lower only for tests.
PASSWORD_HASH_ROUNDS=12

# --- Object storage (invoices, documents) -------------------------------
# Driver: local | s3 | r2 | supabase
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- AI provider --------------------------------------------------------
# Driver: disabled | anthropic | openai
# `disabled` makes every AI surface degrade to a clearly-labelled unavailable
# state instead of fabricating answers.
AI_DRIVER=disabled
AI_API_KEY=
AI_MODEL=claude-sonnet-5
AI_MAX_OUTPUT_TOKENS=8192

# --- Payments / subscriptions ------------------------------------------
# Driver: disabled | razorpay | stripe
# Only razorpay is implemented; stripe is a seam with nothing behind it.
#
# All three Razorpay values are needed before any payment is offered. Without
# the webhook secret a checkout could be opened and never confirmed, which
# takes somebody's money and leaves their plan unchanged — so the billing page
# refuses to show a payment button rather than risk that.
#
# Point the Razorpay dashboard's webhook at:
#   https://your-domain/api/webhooks/razorpay
# subscribed to payment.captured, payment.failed and order.paid. The secret
# below is the one entered on that screen, not the API key secret.
#
# All three are required together. A plan only moves when the webhook confirms
# the payment, so keys without the webhook secret take money and change
# nothing — the application refuses to start rather than let that ship.
PAYMENTS_DRIVER=disabled
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------
# Driver: console | smtp | resend
# The console driver prints messages to the log and reports them delivered,
# including the link in a password reset. It is the development default. A
# production build refuses it unless EMAIL_ALLOW_CONSOLE=true acknowledges that
# this deployment sends no email. smtp and resend are selectable but not yet
# written — see "What this is not ready for" in the README.
EMAIL_DRIVER=console
EMAIL_ALLOW_CONSOLE=false
EMAIL_FROM="Retail Intelligence AI <no-reply@example.com>"
SMTP_URL=
RESEND_API_KEY=

# --- Rate limiting ------------------------------------------------------
# Driver: memory | redis. `memory` is per-instance: with more than one replica
# each instance keeps its own counters, so the effective limit is multiplied by
# the replica count. A production build refuses to start on `memory` unless
# RATE_LIMIT_ALLOW_IN_MEMORY explicitly acknowledges a single-instance deploy.
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_ALLOW_IN_MEMORY=false

# --- Running more than one replica --------------------------------------
# Both optional. INSTANCE_ID defaults to the container hostname, which is
# usually what you want. SHUTDOWN_DRAIN_MS is how long an instance keeps
# answering after SIGTERM so the load balancer can stop routing to it first —
# it must be longer than the balancer's health-check interval, and the
# orchestrator's kill grace period must be longer again.
INSTANCE_ID=
SHUTDOWN_DRAIN_MS=10000
REDIS_URL=

# --- Observability ------------------------------------------------------
LOG_LEVEL=info

# Metrics are off unless this is set. With it, GET /api/metrics returns
# Prometheus text to a caller presenting `Authorization: Bearer <token>`;
# without it the endpoint 404s. Counts are per-process and reset on restart.
# METRICS_TOKEN=

# --- Public (safe to expose to the browser) -----------------------------
NEXT_PUBLIC_APP_NAME="Retail Intelligence AI"
NEXT_PUBLIC_APP_SHORT_NAME="RIAI"
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN

# --- Off-machine backups ------------------------------------------------
# Unset BACKUP_S3_BUCKET means backups stay on the same disk as the database:
# they survive a dropped table and not a dead machine, and every run says so.
#
# Any S3-compatible store works — the only difference is the endpoint:
#   S3          leave BACKUP_S3_ENDPOINT empty, set BACKUP_S3_REGION
#   R2          https://<account>.r2.cloudflarestorage.com, region "auto"
#   Supabase    https://<project>.supabase.co/storage/v1/s3
#   MinIO       http://minio:9000
#
# The credentials want a key scoped to this one bucket, with permission to put,
# list, get and delete — and nothing else. A backup job holding a key that can
# read the rest of your account is a backup job worth compromising.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=riai
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional. STANDARD_IA or GLACIER_IR cost less to keep; anything in Glacier
# proper takes hours to retrieve, which is the wrong trade for a database you
# would be restoring during an incident.
BACKUP_S3_STORAGE_CLASS=
# Optional server-side encryption, e.g. AES256.
BACKUP_S3_SSE=
